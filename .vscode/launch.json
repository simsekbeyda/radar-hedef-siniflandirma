{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Modeli eğit",
            "type": "debugpy",
            "request": "launch",
            "module": "radar_classifier.train",
            "cwd": "${workspaceFolder}",
            "env": { "PYTHONPATH": "${workspaceFolder}/src" }
        },
        {
            "name": "Tahmin aracı (CLI)",
            "type": "debugpy",
            "request": "launch",
            "module": "radar_classifier.predict",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "env": { "PYTHONPATH": "${workspaceFolder}/src" }
        },
        {
            "name": "Streamlit uygulaması",
            "type": "debugpy",
            "request": "launch",
            "module": "streamlit",
            "args": ["run", "app/streamlit_app.py"],
            "cwd": "${workspaceFolder}"
        }
    ]
}
